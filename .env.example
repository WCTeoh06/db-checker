# db-checker configuration
#
# Copy to .env and fill in. .env is gitignored - it holds a real password and
# should not travel over chat or email.
#
# These are the standard PG* variables, the same ones psql uses, so anything that
# already works with psql works here.

PGHOST=db.prod.example.internal
PGPORT=5432
PGUSER=myapp_svc
PGDATABASE=postgres

# Required. No quotes needed even if the password contains $ or other symbols -
# this file is read literally, not by a shell.
PGPASSWORD=

# The v-one server rejects unencrypted connections. Leave as require.
PGSSLMODE=require

# Optional. Path to MyApp's plaintext log folder, on the machine running the
# backend. Set it to enable the export-folder and scheduler checks; leave blank and
# the report will say those checks were skipped.
APP_LOGS_DIR=D:\myapp\database\logs

# How far back the log checks look.
APP_LOG_DAYS=7

# Optional. Only needed if psql is somewhere unusual - the script already looks in
# D:\pgsql\bin, D:\pgsql18\bin and the standard Program Files locations.
# PSQL_PATH=D:\pgsql\bin\psql.exe
