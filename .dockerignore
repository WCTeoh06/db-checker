# Keep these OUT of the build context.
#
# Everything in the context gets sent to the Docker daemon and can end up in a
# layer. A credential baked into a layer is permanent - deleting the file in a
# later instruction does not remove it from the image, and anyone who pulls the
# image can read it.
servers.json
.env
*.bak

# Local state. The container gets its own via volumes.
db-checker.sqlite3
db-checker.sqlite3-*
reports/
__pycache__/
*.pyc

# Not needed at runtime, and node_modules would add ~90MB for nothing.
mcp-server/
*.mcpb
set-export-dir.js
app-preview.png
README.md
.git/
.gitignore
